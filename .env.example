# --- Sunil AI Hyperliquid Analyst — env template (NEVER commit real keys) ---
# The app works WITHOUT an AI key: deterministic engine + local fallback analyst.
# Copy to .env for local dev. All secrets stay server-side / local only.

# Hyperliquid (public, no key required for market data)
VITE_HYPERLIQUID_API=https://api.hyperliquid.xyz
VITE_POLL_INTERVAL_MS=30000
VITE_MARKET_CACHE_MS=60000

# AI provider (optional, local dev escape hatch — prefer a backend proxy in production)
# Frontend never commits secrets. Leave blank to use deterministic + fallback analyst.
VITE_AI_API_KEY=
VITE_AI_MODEL=gpt-4o-mini
VITE_AI_BASE_URL=https://api.openai.com/v1

# UI defaults
VITE_DEFAULT_CATEGORY=STOCKS
VITE_DEFAULT_TIMEFRAME=15m
